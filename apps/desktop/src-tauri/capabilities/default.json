{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core APIs and file dialogs (file contents are read/written by the app's own commands).",
  "windows": ["main"],
  "permissions": ["core:default", "core:window:allow-destroy", "core:window:allow-set-title", "dialog:allow-open", "dialog:allow-save", "dialog:allow-ask", "dialog:allow-message"]
}
